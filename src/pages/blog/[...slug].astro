---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../../scripts/legacy-heading-ids.mjs';
export async function getStaticPaths() { return (await getCollection('blog', ({ data }) => !data.draft)).map(post => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const used = new Map();
const tocHeadings = headings.map(h => { const base = slugify(h.text); const count = used.get(base) || 0; used.set(base, count + 1); return { ...h, legacySlug: count ? `${base}-${count}` : base }; });
---
<Base title={post.data.title} description={post.data.description} article>
<header class="article-header"><a class="back-link" href="/blog/">← Blog</a><time datetime={post.data.date}>{post.data.date}</time><h1>{post.data.title}</h1><p>{post.data.description}</p></header>
<div class="article-grid"><article class="prose"><Content /></article>{headings.length > 0 && <aside class="toc"><nav aria-label="Índice"><h2>Índice</h2><ul>{tocHeadings.filter(h => h.depth <= 3).map(h => <li class:list={{nested:h.depth === 3}}><a href={`#${h.legacySlug}`}>{h.text}</a></li>)}</ul></nav></aside>}</div>
</Base>
