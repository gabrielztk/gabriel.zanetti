---
import { Image } from "astro:assets";
import portrait from "../../public/img/avatar.jpg";
import profile from "../data/profile.json";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="profile-introduction">
        <Image class="avatar" src={portrait} alt="Gabriel Kawall" width={220} height={220} widths={[160,220,320,440,480,660]} sizes="(max-width: 520px) 160px, 220px" format="webp" quality={80} fit="cover" loading="eager" fetchpriority="high" decoding="async" />
        <div><h1 class="my-4 text-3xl font-bold sm:text-4xl">Gabriel Kawall</h1><Socials /></div>
      </div>
      <p class="mt-6">{profile.intro}</p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <section><h2 class="mb-3 text-xl font-semibold">Interesses</h2><ul class="list-disc ps-5">{profile.interests.map(interest => <li>{interest}</li>)}</ul></section>
        <section><h2 class="mb-3 text-xl font-semibold">Formação</h2><ol class="space-y-4">{profile.education.map(course => <li><span class="text-sm opacity-75">{course.year}</span><strong class="block">{course.course}</strong><span class="block text-sm">{course.type}</span><span class="block text-sm">{course.institution}</span></li>)}</ol></section>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "blog")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
