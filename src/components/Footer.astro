---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-row-reverse flex-nowrap items-center justify-between gap-4 border-t py-4"
  >
    <Socials iconsOnly />
    <div class="my-2 whitespace-nowrap">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
    </div>
  </div>
</footer>
